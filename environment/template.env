POSTGRES_HOST=localhost:5432
POSTGRES_DB=pep-db
POSTGRES_USER=docker
POSTGRES_PASSWORD=password

QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_ENABLED=true
QDRANT_API_KEY="my_seret_key"

GH_CLIENT_ID=client_id
GH_CLIENT_SECRET=client_secret
BASE_URI="http://localhost:8000"

# Query embeddings: "local" (in-process, needs requirements-embed-local.txt) or "tei"
EMBEDDING_MODE=local
EMBEDDING_DENSE_MODEL="BAAI/bge-small-en-v1.5"
# EMBEDDING_SPARSE_MODEL="prithivida/Splade_PP_en_v2"
# TEI mode:
# EMBEDDING_DENSE_URL="http://localhost:8080"
# EMBEDDING_SPARSE_URL="http://localhost:8081"
# EMBEDDING_API_KEY="..."
# EMBEDDING_TIMEOUT=10
